# Python bytecode cache — auto-generated, never commit
__pycache__/
*.py[cod]
*.pyo

# Python virtual environment
.venv/

# Python tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Node / npm
node_modules/

# Compiled TypeScript output
out/
out-test/

# Release artifacts: built locally and published to GitHub Releases, not
# committed (archived per release-management; kept on disk only)
*.vsix
*.mcpb
*.zip
releases/
archive/

# OS artefacts
.DS_Store
Thumbs.db

# Editor directories
.vscode/settings.json
.vscode/launch.json

# Gradle local cache (machine-specific, auto-regenerated)
pycharm/.gradle/

# Gradle build output — auto-regenerated by buildPlugin (the release zip in
# build/distributions/ is kept locally and published to GitHub Releases)
pycharm/build/

downloaded_sprites/

# IDE project files
.idea/

# Generated from vscode/media by pycharm/build.gradle.kts (processResources)
pycharm/src/main/resources/webview/

# Leaderboard HMAC key — never commit (see developer_notes/leaderboard/ADMIN.md)
.leaderboard-key
**/src/leaderboardKey.ts
pycharm/src/main/kotlin/com/codotchi/generated/
